# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env files to version control

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_API_TIMEOUT=10000

# Authentication
REACT_APP_AUTH_ENABLED=true
REACT_APP_JWT_SECRET_KEY=your_jwt_secret_key_here

# Google Maps API (for location-based booking features)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway (Stripe, PayPal, etc.)
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
REACT_APP_PAYMENT_ENABLED=true

# Firebase Configuration (if using Firebase for real-time features)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# Analytics & Monitoring
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_SENTRY_DSN=your_sentry_dsn_url

# App Version & Environment
REACT_APP_VERSION=0.1.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_BETA_FEATURES=false

# Logging
REACT_APP_LOG_LEVEL=debug
REACT_APP_LOG_TO_CONSOLE=true

# Third-party Services
REACT_APP_CRISP_CHAT_ID=your_crisp_chat_id_here
REACT_APP_HOTJAR_ID=your_hotjar_id_here

# URLs
REACT_APP_PUBLIC_URL=http://localhost:3000
REACT_APP_SUPPORT_URL=https://support.bookmycleaning.com
REACT_APP_PRIVACY_POLICY_URL=https://bookmycleaning.com/privacy
REACT_APP_TERMS_OF_SERVICE_URL=https://bookmycleaning.com/terms

# Rate Limiting & Security
REACT_APP_RATE_LIMIT_ENABLED=true
REACT_APP_MAX_REQUESTS_PER_MINUTE=60

# Mobile Specific
REACT_APP_MOBILE_APP_VERSION=0.1.0
REACT_APP_MINIMUM_SUPPORTED_VERSION=0.1.0
